# OpenAI-compatible structured model backend.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional role-specific overrides. When blank, OPENAI_MODEL is used.
OPENAI_PLANNING_MODEL=
OPENAI_SUMMARY_MODEL=

# Optional LangSmith tracing. Credentials remain local and are never written
# into Run artifacts or model receipts.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=specrag
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
