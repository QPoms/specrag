# Copy this file to .env and provide an OpenAI-compatible endpoint.
# .env is ignored by Git.

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=your-model-id
OPENAI_PLANNING_MODEL=your-planning-model-id
OPENAI_SUMMARY_MODEL=your-summary-model-id

# Retry and fallback policy is configured in config.yaml.
